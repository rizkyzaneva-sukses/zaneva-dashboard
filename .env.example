# Salin ke .env untuk lokal. Di EasyPanel isi sebagai Environment di tab app (jangan commit .env asli).

# Postgres. Di EasyPanel: pakai hostname internal service DB, contoh:
# postgresql://USER:PASS@NAMA_PROJECT_zaneva-db:5432/zaneva_dashboard
DATABASE_URL=postgresql://postgres:GANTI@127.0.0.1:5432/zaneva_dashboard

# Wajib >= 32 karakter acak. Buat: openssl rand -base64 48
SESSION_SECRET=
SESSION_COOKIE_NAME=zaneva_session

# Hanya dipakai `npm run db:seed` (jalankan dari PC lokal). Jangan pakai "admin123".
SEED_ADMIN_PASSWORD=
